<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for both dbService and the dbgit client, since both load this classpath. The client never logs anything
  itself - Main prints straight to System.out/System.err, which is the user-facing output tests assert on - so in
  practice only the daemon (and jOOQ, which auto-detects SLF4J and routes its own banner/SQL logging through it
  once this is on the classpath) ever writes through this configuration.

  logs/dbService.log is relative to the daemon's working directory, which the ./dbService wrapper sets to the
  repo root before starting Maven - so the file lands at <repo root>/logs/dbService.log regardless of where the
  daemon was launched from.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/dbService.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/dbService.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
